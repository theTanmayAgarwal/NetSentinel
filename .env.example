# Copy to .env and adjust as needed. Safe defaults shown — no real secrets.

APP_NAME="AI-Driven Multi-Vendor Network Security Compliance Auditor"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS: comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. SQLite by default; the persistence layer is DB-agnostic.
# For Postgres later: postgresql+psycopg://user:pass@localhost:5432/netaudit
DATABASE_URL=sqlite:///./data/app.db

# Embedding backend for the unknown-command learning loop:
#   auto     -> use sentence-transformers if installed, else the built-in offline fallback
#   minilm   -> force sentence-transformers (all-MiniLM-L6-v2)
#   hashing  -> force the built-in offline fallback (no downloads, always available)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cosine-similarity threshold above which an unknown command is auto-classified (0..1).
SIMILARITY_THRESHOLD=0.80

# ---- Frontend (Vite) ----
# Leave unset in dev to use the Vite proxy at /api. If set, include the /api suffix,
# e.g. VITE_API_BASE_URL=http://localhost:8000/api
# VITE_API_BASE_URL=
